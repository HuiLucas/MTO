FoamFile
{
    format      ascii;
    class       volVectorField;
    location    "0";
    object      Ua;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 1 -1 0 0 0 0];

internalField   uniform (0 0 0);

boundaryField
{
    inlet
    {
        type            fixedValue;
        value           uniform (0 -0.05 0);
    }
    outlet
    {
        type            adjointOutletVelocityPower;
        value           nonuniform List<vector> 0();
    }
    Wall
    {
        type            noSlip;
    }
    right
    {
        type            symmetry;
    }
    frontAndBack
    {
        type            empty;
    }
    procBoundary1to0
    {
        type            processor;
        value           uniform (0 0 0);
    }
}


