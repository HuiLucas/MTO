FoamFile
{
    format      ascii;
    class       volVectorField;
    location    "0";
    object      Ub;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 1 -1 0 0 0 0];

internalField   uniform (0 0 0);

boundaryField
{
    inlet
    {
        type            fixedValue;
        value           nonuniform List<vector> 0();
    }
    outlet
    {
        type            adjointOutletVelocityHeat;
        value           nonuniform List<vector> 0();
    }
    force
    {
        type            noSlip;
    }
    wall
    {
        type            noSlip;
    }
    sym
    {
        type            symmetry;
    }
    procBoundary11to5
    {
        type            processor;
        value           uniform (0 0 0);
    }
    procBoundary11to6
    {
        type            processor;
        value           uniform (0 0 0);
    }
    procBoundary11to7
    {
        type            processor;
        value           uniform (0 0 0);
    }
    procBoundary11to9
    {
        type            processor;
        value           uniform (0 0 0);
    }
    procBoundary11to10
    {
        type            processor;
        value           uniform (0 0 0);
    }
    procBoundary11to15
    {
        type            processor;
        value           uniform (0 0 0);
    }
}


