FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "constant";
    object      transportProperties;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

transportModel  Newtonian;
// fluid
nu                           nu [0 2 -1 0 0 0 0] 1e-06;
alphaMax               alphaMax [0 0 -1 0 0 0 0] 53333.3333333;
alphamax               alphamax [0 0 -1 0 0 0 0] 53333.3333333;

// opt
raa0                   0.5;
mma_init               0.5;
mma_dec                0.7;
mma_inc                1.2;
movlim                 0.4;

voluse                 0.2;
filter_Radius          2;
solid_area             0;
fluid_area             1;
test_PD                0;

D_normalization        1e-09;
D0                     160;
D1                     150000;
geo_dim                3;

b1                     b1 [0 2 -2 -2 0 0 0] 1;
qu                     0.005;
opt1                   1;
opt2                   1;


// ************************************************************************* //
